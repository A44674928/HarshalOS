{
  "name": "harshalos",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".site-assets", "not_found_handling": "none", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Wrangler runs this custom build before bundling for every command
  // (dev/deploy/preview), so `.site-assets` is regenerated even when the
  // pipeline invokes `wrangler preview` directly without `prepare:assets`.
  "build": { "command": "node scripts/prepare-assets.mjs" },
  // Secrets are deliberately not declared here: MONGODB_URI, the Cloudflare Access
  // variables, TICKERBOT_API_KEY and the Z.AI relay key (Z.AI or ZAI_API_KEY) are set
  // with `wrangler secret put` or the dashboard so no credential ever enters Git.
  // See docs/deployment/MONGODB-SETUP.md and docs/deployment/ZAI-FREE-TIER.md.
  "vars": { "MONGODB_DATABASE": "harshalos" },
  // Required by `wrangler preview` (Workers Previews). Keep previews off the
  // production database: production uses "harshalos" (see vars above).
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    // Temporary diagnostic experiment requested by the operator: bypass only
    // this Worker’s in-memory caller/shared rate guards in branch previews.
    // Z.AI still enforces its own quotas. Never copy this setting to production;
    // branch preview URLs are public and share the preview Z.AI secret/quota.
    "vars": {
      "MONGODB_DATABASE": "harshalos_preview",
      "LLM_RELAY_DISABLE_RATE_LIMITS": "true"
    }
  }
}
