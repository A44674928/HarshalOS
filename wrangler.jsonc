{
  "name": "harshalos",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".site-assets",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/account", "/account.html", "/audits", "/audits.html"]
  },

  // Regenerate the public asset staging directory before Wrangler bundles.
  "build": {
    "command": "node scripts/prepare-assets.mjs"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },

  // Production database identified by the owner; no remote migration applied.
  "d1_databases": [{
    "binding": "COMMUNITY_DB",
    "database_name": "community_db",
    "database_id": "ea508a07-e00c-4d41-a657-428937ba8110",
    "migrations_dir": "migrations/community"
  }],

  // Secrets are configured in Cloudflare, not in this file.
  "vars": {
    "MONGODB_DATABASE": "harshalos",
    "COMMUNITY_ENABLED": "false",
    "OIDC_ADMIN_SUBJECTS": "auth0|6ac0807a3d49089da60ed21e"
  },

  // Preview uses a separate database. Branch preview URLs are public, so add a
  // temporary preview-only switch here (LLM_RELAY_DISABLE_RATE_LIMITS,
  // LLM_RELAY_OUTBOUND_DIAGNOSTIC; see docs/deployment/ZAI-FREE-TIER.md) only for
  // as long as it is needed, never in the base "vars" above, and remove it after.
  "previews": {
    "vars": {
      "MONGODB_DATABASE": "harshalos_preview"
    }
  }
}
