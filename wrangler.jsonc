{
  "name": "harshalos",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Preserve dashboard-only text variables; explicit vars below still win.
  "keep_vars": true,
  // The Orb 2 server field: one beat tick each minute. The tick itself enforces
  // Massive's shared five-requests-per-minute envelope, its durable UTC-day D1
  // guard, and Tickerbot's durable UTC-month ledger, so the schedule cannot
  // outspend the provider plan. Migration 0009 must be applied before deploy.
  // Reliability note: a normal tick uses ~18 ms+ of CPU against the Workers
  // Free 10 ms budget per Cron Trigger, so on Free the platform may kill ticks
  // with outcome "exceededCpu" and the field goes stale. Cheapest fix first:
  // dashboard → Workers → Settings → Placement → Smart, Cache → Enabled. If
  // kills persist, the backstop is Workers Paid (30 s CPU for sub-hourly
  // crons). See docs/deployment/ORB2-CRON-PLAN.md.
  "triggers": {
    "crons": ["*/1 * * * *"]
  },

  // The named FRONTIERSHIP bundle contains private project/economic details.
  // Static files rely on the externally configured Cloudflare Access policy;
  // this Worker config does not install or verify that policy. Confirm it gates
  // the main host and direct /js, /css, /private, and /terrain asset requests.
  "assets": {
    "directory": ".site-assets",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/account", "/account.html", "/audits", "/audits.html", "/observations", "/observations.html", "/neo-orb", "/neo-orb.html", "/.git", "/.git/*", "/.env*"]
  },

  // Regenerate the public asset staging directory before Wrangler bundles.
  "build": {
    "command": "node scripts/prepare-assets.mjs"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Alpha Vantage requires its API key in the query string; never persist query values in logs/traces.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },

  // Production database identified by the owner; no remote migration applied.
  "d1_databases": [{
    "binding": "COMMUNITY_DB",
    "database_name": "community_db",
    "database_id": "ea508a07-e00c-4d41-a657-428937ba8110",
    "migrations_dir": "migrations/community"
  }],

  // Preserve the owner-confirmed binding. Storage still uses MongoDB; this
  // does not migrate data or implement R2-primary / MongoDB-backup.
  "r2_buckets": [{
    "binding": "STORAGE_BUCKET",
    "bucket_name": "main-empty-domains"
  }],

  // Secrets are configured in Cloudflare, not in this file.
  // Twelve Data free (800/day 8/min delayed 1-15min, 3 markets) is
  // personal/internal only (Basic/Grow/Pro internal, no third-party display;
  // Business Venture+ for public commercial display). With COMMUNITY_ENABLED
  // false and an Access app on main.empty.domains/* the site qualifies as
  // sole private use, so FX/index daily bars can run on Twelve Data
  // via TWELVEDATA_API_KEY (set as a Worker secret, never in this file).
  // When that secret is set the field's FX/index lanes use Twelve Data;
  // the Disc4 futures lane always stays on Massive (MASSIVE_API_KEY, verified
  // active contracts) because Twelve Data does not replace it. Remove the
  // Twelve Data secret to put FX/indices back on Massive (5/min per asset
  // class). Massive's XXX is deployments, not content.
  "vars": {
    "MONGODB_DATABASE": "harshalos",
    // The Cloudflare Worker owns the Orb 2 provider beats: its own Cron
    // Trigger runs the tick unless ORB2_FIELD_TICK=off. Pin "on" here so a
    // dashboard-set "off" cannot survive a deploy (keep_vars only preserves
    // dashboard vars the file does not declare). To hand the beats to the
    // off-Cloudflare runner, set this to "off" explicitly instead — see
    // docs/deployment/ORB2-BEAT-RUNNER.md. Free-plan CPU note: a tick can
    // exceed the 10 ms cron budget (see the triggers comment above and
    // docs/deployment/ORB2-CRON-PLAN.md); the publication slice and the
    // live-read fallback keep the served field correct either way.
    "ORB2_FIELD_TICK": "on",
    // Sole private use: community publication disabled so the site renders
    // Orb 2 field only. COMMUNITY_DB binding stays for the field itself.
    // Set ACCESS_TEAM_DOMAIN/ACCESS_AUD/OWNER_EMAIL secrets and an Access
    // app for main.empty.domains/* to gate the whole site to one email.
    "COMMUNITY_ENABLED": "false",
    "COMMUNITY_ORIGIN": "https://main.empty.domains",
    "OIDC_ADMIN_SUBJECTS": "auth0|6ac0807a3d49089da60ed21e",
    "OIDC_CLIENT_ID": "44b3124PsQvzfGQ7YOxG7bhagGWrNsxl",
    "OIDC_ISSUER": "https://dev-0yvxnqrjxm7dtqu4.us.auth0.com/"
  },

  // Preview uses a separate database. Branch preview URLs are public, so add a
  // temporary preview-only switch here only for as long as it is needed, never
  // in the base "vars" above, and remove it after.
  "previews": {
    // No production D1 or R2 access in branch previews.
    "d1_databases": [],
    "r2_buckets": [],
    "vars": {
      "COMMUNITY_ENABLED": "false",
      "MONGODB_DATABASE": "harshalos_preview"
    }
  }
}
