{
  "name": "harshalos",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".site-assets", "not_found_handling": "none", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Wrangler runs this custom build before bundling for every command
  // (dev/deploy/preview), so `.site-assets` is regenerated even when the
  // pipeline invokes `wrangler preview` directly without `prepare:assets`.
  "build": { "command": "node scripts/prepare-assets.mjs" },
  "vars": { "MONGODB_DATABASE": "harshalos" },
  // Required by `wrangler preview` (Workers Previews). Keep previews off the
  // production database: production uses "harshalos" (see vars above).
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    "vars": { "MONGODB_DATABASE": "harshalos_preview" }
  }
}
