{
  "name": "harshalos",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Preserve dashboard-only text variables; explicit vars below still win.
  "keep_vars": true,
  // The Orb 2 server field: one beat tick each minute. The tick itself enforces
  // Massive's shared five-requests-per-minute envelope, its durable UTC-day D1
  // guard, and Tickerbot's durable UTC-month ledger, so the schedule cannot
  // outspend the provider plan. Migration 0009 must be applied before deploy.
  // Reliability note: a normal tick uses ~18 ms+ of CPU against the Workers
  // Free 10 ms budget per Cron Trigger, so on Free the platform may kill ticks
  // with outcome "exceededCpu" and the field goes stale. Cheapest fix first:
  // dashboard → Workers → Settings → Placement → Smart, Cache → Enabled. If
  // kills persist, the backstop is Workers Paid (30 s CPU for sub-hourly
  // crons). See docs/deployment/ORB2-CRON-PLAN.md.
  "triggers": {
    "crons": ["*/1 * * * *"]
  },

  "assets": {
    "directory": ".site-assets",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/account", "/account.html", "/audits", "/audits.html", "/.git", "/.git/*", "/.env*"]
  },

  // Regenerate the public asset staging directory before Wrangler bundles.
  "build": {
    "command": "node scripts/prepare-assets.mjs"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Alpha Vantage requires its API key in the query string; never persist query values in logs/traces.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },

  // Production database identified by the owner; no remote migration applied.
  "d1_databases": [{
    "binding": "COMMUNITY_DB",
    "database_name": "community_db",
    "database_id": "ea508a07-e00c-4d41-a657-428937ba8110",
    "migrations_dir": "migrations/community"
  }],

  // Preserve the owner-confirmed binding. Storage still uses MongoDB; this
  // does not migrate data or implement R2-primary / MongoDB-backup.
  "r2_buckets": [{
    "binding": "STORAGE_BUCKET",
    "bucket_name": "main-empty-domains"
  }],

  // The LLM relay's primary provider. With this binding present the relay
  // serves Workers AI's free daily Neuron allocation (see
  // docs/deployment/WORKERS-AI-PROVIDER.md) and the durable per-day ledger in
  // migration 0014 refuses new calls before the allowance is spent. Without
  // it, the relay falls back to the Z.AI key path when a key is set.
  "ai": { "binding": "AI" },

  // Secrets are configured in Cloudflare, not in this file.
  "vars": {
    "MONGODB_DATABASE": "harshalos",
    // Enablement decision. Explicit file values win over dashboard text variables.
    // Requires the dashboard origin/OIDC variables and secrets, applied migrations,
    // and a configured moderator before the feature is actually usable.
    "COMMUNITY_ENABLED": "true",
    "OIDC_ADMIN_SUBJECTS": "auth0|6ac0807a3d49089da60ed21e"
  },

  // Preview uses a separate database. Branch preview URLs are public, so add a
  // temporary preview-only switch here (LLM_RELAY_DISABLE_RATE_LIMITS,
  // LLM_RELAY_OUTBOUND_DIAGNOSTIC; see docs/deployment/ZAI-FREE-TIER.md) only for
  // as long as it is needed, never in the base "vars" above, and remove it after.
  "previews": {
    // No production D1 or R2 access in branch previews. The relay is switched
    // off there too: the AI binding is account-wide, so without this a public
    // preview could spend the shared daily Neuron allocation.
    "d1_databases": [],
    "r2_buckets": [],
    "vars": {
      "COMMUNITY_ENABLED": "false",
      "MONGODB_DATABASE": "harshalos_preview",
      "LLM_RELAY_ENABLED": "false"
    }
  }
}
