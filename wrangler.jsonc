{
  "name": "harshalos",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".site-assets",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Regenerate the public asset staging directory before Wrangler bundles.
  "build": {
    "command": "node scripts/prepare-assets.mjs"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },

  // Secrets are configured in Cloudflare, not in this file.
  "vars": {
    "MONGODB_DATABASE": "harshalos"
  },

  // Preview uses a separate database. LLM_RELAY_DISABLE_RATE_LIMITS is a
  // temporary switch that applies only to public branch previews—not production.
  "previews": {
    "vars": {
      "MONGODB_DATABASE": "harshalos_preview",
      "LLM_RELAY_DISABLE_RATE_LIMITS": "true"
    }
  }
}
