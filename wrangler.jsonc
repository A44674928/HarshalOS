{
  "name": "harshalos",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".site-assets", "not_found_handling": "none", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "MONGODB_DATABASE": "harshalos" }
}
