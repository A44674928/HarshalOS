\pard\pardeftab720\sa100\partightenfactor0

\f0\b\fs28 \cf4 \outl0\strokewidth-143 11. WHY \'93THE INSURANCE COMPANY\'94 IS THE RIGHT METAPHOR\
\pard\pardeftab720\sl264\slmult1\sa320\partightenfactor0

\f1\b0\fs20 \cf2 \outl0\strokewidth-200 Insurance does not prevent accidents, decide fault, or command behavior. It makes failure survivable. Quasar Mode exists to make institutional failure legible and survivable, not avoidable.\
\pard\pardeftab720\sa100\partightenfactor0

\f0\b\fs28 \cf4 \outl0\strokewidth-143 12. CANONICAL STATEMENT\
\pard\pardeftab720\sl264\slmult1\sa360\partightenfactor0

