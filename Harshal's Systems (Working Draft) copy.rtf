\f0\b\fs28 \cf4 \outl0\strokewidth-143 3. Core Axioms\
\pard\tx20\tx290\tx408\pardeftab720\li602\fi-602\sl264\slmult1\sa160\partightenfactor0
\ls37\ilvl0
\f1\b0\fs20 \cf2 \cb1 \up0 \nosupersub \ulnone \outl0\strokewidth0 {\listtext	2.	}\cb3 \up0 \nosupersub \ulnone Single-Origin Axiom\cb1 \
\pard\pardeftab720\sl264\slmult1\sa320\partightenfactor0
\cf2 \cb3 \outl0\strokewidth-200 \strokec2 Every valid address in the orb MUST derive from exactly one center point.\
\pard\pardeftab720\sa100\partightenfactor0

\f0\b\fs28 \cf4 \outl0\strokewidth-143 2. Direct Attachment Axiom\
\pard\pardeftab720\sl264\slmult1\sa320\partightenfactor0

\f1\b0\fs20 \cf2 \outl0\strokewidth-200 All nodes attach directly to the center, not to other nodes.\
\pard\pardeftab720\sa100\partightenfactor0

\f0\b\fs28 \cf4 \outl0\strokewidth-143 3. Lateral Communication Axiom\
\pard\pardeftab720\sl264\slmult1\sa320\partightenfactor0

\f1\b0\fs20 \cf2 \outl0\strokewidth-200 Nodes may communicate with any other node without reauthorization.\
\pard\pardeftab720\sa100\partightenfactor0

\f0\b\fs28 \cf4 \outl0\strokewidth-143 4. Ownership Non-Transfer Axiom\
\pard\pardeftab720\sl264\slmult1\sa320\partightenfactor0

\f1\b0\fs20 \cf2 \outl0\strokewidth-200 Communication does not confer ownership, authority, or origin rights.\
\pard\pardeftab720\sa100\partightenfactor0

\f0\b\fs28 \cf4 \outl0\strokewidth-143 5. Collapse-on-Origin-Removal Axiom\
\pard\pardeftab720\sl264\slmult1\sa320\partightenfactor0

\f1\b0\fs20 \cf2 \outl0\strokewidth-200 Removal or invalidation of the center invalidates the addressing system.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs28 \cf4 \outl0\strokewidth-143 4. Addressing Scheme\
