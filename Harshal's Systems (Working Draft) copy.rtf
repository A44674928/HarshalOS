\uc0\u9474                                                                \u9474 \
\uc0\u9474  3. TEMPORAL FRESHNESS CHECK:                                 \u9474 \
\uc0\u9474     LET now = current timestamp                               \u9474 \
\uc0\u9474     LET \u916 t = (now - Effective-Timestamp)                      \u9474 \
