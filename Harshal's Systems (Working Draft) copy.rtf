\uc0\u9474        \'95 Time-Authority-Effect = Degrades                     \u9474 \
\uc0\u9474                                                                \u9474 \
\uc0\u9474     IF (Declared-Phase = CWO)                                 \u9474 \
\uc0\u9474        THEN require:                                          \u9474 \
\uc0\u9474        \'95 Center-Capability = Custodial                        \u9474 \
\uc0\u9474        \'95 Legitimacy-Source = Observed-Only                    \u9474 \
\uc0\u9474        \'95 Refusal-Semantics = Expository                       \u9474 \
