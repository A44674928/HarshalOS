\uc0\u9474        \'95 Legitimacy-Source = Internal                         \u9474 \
\uc0\u9474        \'95 Refusal-Semantics = Override-able                    \u9474 \
\uc0\u9474        \'95 Symbolism-Executability = Enabled                    \u9474 \
\uc0\u9474        \'95 Time-Authority-Effect = Confirms                     \u9474 \
\uc0\u9474                                                                \u9474 \
