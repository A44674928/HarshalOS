\cf2 \outl0\strokewidth-200 \strokec2 ## 7. Control 5 \'97 Neural-data minimization and lifecycle\
\pard\pardeftab720\partightenfactor0

\fs17 \cf2 \cb6 \outl0\strokewidth0 ```ts\
interface AuditEvent \{\
  eventId: string;\
  eventType: string;\
  occurredAt: Instant;\
  sessionId: string;\
  actorRole: string;\
  actionHash?: Hash;\
  signalHash?: Hash;\
