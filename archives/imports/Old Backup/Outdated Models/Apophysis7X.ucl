  xform_vars[9,17] = @xf9_var17
  
  xform_density[10] = @xf10_p
  xform_color[10] = @xf10_c
  xform_symmetry[10] = @xf10_sym
  xform_coefs[10,0] = @xf10_cfa
  xform_coefs[10,1] = @xf10_cfb
  xform_coefs[10,2] = @xf10_cfc
  xform_coefs[10,3] = @xf10_cfd
