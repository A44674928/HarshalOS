+++ b/css/massive.css
@@ -0,0 +1,351 @@
+/* ═══════════════════════════════════════════════════════════════
+   HarshalOS — Massive Markets (read-only Massive REST viewer)
+   Display-only market data; no advice, no orders, no keys.
+   ═══════════════════════════════════════════════════════════════ */
+
+.mvm {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 18px 20px 22px;
+  font-family: var(--sans);
+  color: var(--text);
+}
+
+/* ── masthead ── */
+.mvm-masthead {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  border-bottom: 1px solid var(--line);
+  padding-bottom: 12px;
+}
+.mvm-wordmark {
+  font-family: var(--mono);
+  font-size: 11px;
+  letter-spacing: 0.22em;
+  color: var(--text-faint);
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 6px;
+}
+.mvm-wordmark span { color: var(--gold-deep); }
+.mvm-mark {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: radial-gradient(circle at 32% 30%, var(--ice), var(--water) 62%, transparent 72%);
+  box-shadow: 0 0 10px rgba(111, 211, 255, 0.55);
+  display: inline-block;
+}
+.mvm-heading h1 {
+  font-size: 30px;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  line-height: 1.1;
+}
+.mvm-heading p {
+  margin-top: 6px;
+  color: var(--text-dim);
+  font-size: 13px;
+  max-width: 64ch;
+}
+.mvm-edition {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 2px;
+  border: 1px solid var(--line-hi);
+  border-radius: var(--radius);
+  padding: 8px 14px;
+  font-family: var(--mono);
+  font-size: 9px;
+  letter-spacing: 0.26em;
+  color: var(--text-faint);
+  background: linear-gradient(180deg, rgba(111, 211, 255, 0.06), rgba(111, 211, 255, 0));
+}
+.mvm-edition strong {
+  font-size: 18px;
+  letter-spacing: 0.12em;
+  color: var(--ice);
+}
+
+/* ── boundary strip ── */
+.mvm-boundary {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  border: 1px solid rgba(255, 180, 92, 0.4);
+  background: rgba(255, 180, 92, 0.07);
+  border-radius: var(--radius);
+  padding: 8px 12px;
+  font-size: 12px;
+  color: var(--text-dim);
+}
+.mvm-boundary-label {
+  font-family: var(--mono);
+  font-size: 10px;
+  letter-spacing: 0.18em;
+  color: var(--warn);
+  border: 1px solid rgba(255, 180, 92, 0.5);
+  border-radius: 6px;
+  padding: 3px 7px;
+  white-space: nowrap;
+}
+
+/* ── controls ── */
+.mvm-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  gap: 12px;
+}
+.mvm-field {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+.mvm-field span {
+  font-family: var(--mono);
+  font-size: 10px;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--text-faint);
+}
+.mvm-field select,
+.mvm-field input {
+  background: var(--bg-2);
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  color: var(--text);
+  padding: 8px 10px;
+  font-size: 13px;
+  font-family: var(--mono);
+  min-width: 110px;
+}
+.mvm-field-grow { flex: 1 1 240px; }
+.mvm-field-grow input { width: 100%; }
+.mvm-field select:focus,
+.mvm-field input:focus {
+  outline: none;
+  border-color: var(--ice);
+  box-shadow: 0 0 0 2px rgba(111, 211, 255, 0.18);
+}
+
+.mvm-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 7px;
+}
+.mvm-chip {
+  font-family: var(--mono);
+  font-size: 11px;
+  letter-spacing: 0.06em;
+  color: var(--text-dim);
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  padding: 4px 11px;
+  background: rgba(13, 21, 40, 0.6);
+}
+.mvm-chip:hover { border-color: var(--ice); color: var(--ice); }
+.mvm-chip.active { border-color: var(--ice); color: var(--ice); background: rgba(111, 211, 255, 0.1); }
+
+/* ── tabs ── */
+.mvm-tabs {
+  display: flex;
+  gap: 6px;
+  border-bottom: 1px solid var(--line);
+}
+.mvm-tab {
+  font-family: var(--mono);
+  font-size: 12px;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--text-faint);
+  padding: 8px 14px;
+  border: 1px solid transparent;
+  border-bottom: none;
+  border-radius: 8px 8px 0 0;
+}
+.mvm-tab:hover { color: var(--text-dim); }
+.mvm-tab.active {
+  color: var(--ice);
+  border-color: var(--line);
+  background: var(--panel-hi);
+}
+
+/* ── status ── */
+.mvm-status {
+  font-size: 12.5px;
+  color: var(--text-dim);
+  min-height: 18px;
+}
+.mvm-status-kind {
+  font-family: var(--mono);
+  font-size: 10px;
+  letter-spacing: 0.14em;
+  border-radius: 5px;
+  padding: 2px 6px;
+  margin-right: 6px;
+}
+.mvm-status-ok { color: var(--permit); border: 1px solid rgba(92, 230, 168, 0.45); }
+.mvm-status-busy { color: var(--ice); border: 1px solid rgba(111, 211, 255, 0.45); }
+.mvm-status-refusal { color: var(--refusal); border: 1px solid rgba(255, 92, 122, 0.45); }
+
+/* ── panels ── */
+.mvm-panel { display: block; }
+.mvm-empty {
+  color: var(--text-faint);
+  font-size: 13px;
+  padding: 18px 4px;
+}
+.mvm-rule {
+  border-radius: var(--radius);
+  padding: 10px 14px;
+  font-size: 13px;
+  margin: 8px 0;
+  border: 1px solid var(--line);
+  background: rgba(13, 21, 40, 0.5);
+}
+.mvm-rule.refusal {
+  border-color: rgba(255, 92, 122, 0.5);
+  background: rgba(255, 92, 122, 0.08);
+  color: var(--text-dim);
+}
+
+.mvm-kv {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
+  gap: 8px 22px;
+  margin: 6px 0;
+}
+.mvm-kv .k {
+  font-family: var(--mono);
+  font-size: 10px;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--text-faint);
+}
+.mvm-kv .v { font-size: 13.5px; }
+.mvm-up { color: var(--permit); }
+.mvm-down { color: var(--refusal); }
+.mvm-home { margin-top: 8px; }
+.mvm-home a {
+  color: var(--ice);
+  font-family: var(--mono);
+  font-size: 12px;
+  text-decoration: none;
+  border-bottom: 1px dotted rgba(111, 211, 255, 0.5);
+}
+.mvm-home a:hover { color: var(--gold); border-color: rgba(255, 212, 121, 0.6); }
+.mvm-desc {
+  margin-top: 10px;
+  color: var(--text-dim);
+  font-size: 13px;
+  line-height: 1.6;
+  border-left: 2px solid var(--line-hi);
+  padding-left: 12px;
+}
+
+/* ── bars ── */
+.mvm-bar-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  gap: 12px;
+  margin-bottom: 12px;
+}
+.mvm-bar-stats {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 10px;
+}
+.mvm-stat {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+  padding: 6px 12px;
+  background: rgba(13, 21, 40, 0.5);
+}
+.mvm-stat span {
+  font-family: var(--mono);
+  font-size: 9.5px;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--text-faint);
+}
+.mvm-stat strong { font-size: 13.5px; font-weight: 600; }
+.mvm-bar-chart svg {
+  width: 100%;
+  height: auto;
+  display: block;
+  background: var(--bg-1);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+}
+.mvm-chart-note {
+  margin-top: 7px;
+  font-family: var(--mono);
+  font-size: 10.5px;
+  letter-spacing: 0.08em;
+  color: var(--text-faint);
+}
+.mvm-bar-table table,
+.mvm-div-table table {
+  width: 100%;
+  border-collapse: collapse;
+  margin-top: 12px;
+  font-size: 12.5px;
+}
+.mvm-bar-table th,
+.mvm-div-table th {
+  font-family: var(--mono);
+  font-size: 10px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--text-faint);
+  text-align: left;
+  border-bottom: 1px solid var(--line-hi);
+  padding: 6px 8px;
+}
+.mvm-bar-table td,
+.mvm-div-table td {
+  border-bottom: 1px solid var(--line);
+  padding: 6px 8px;
+  color: var(--text-dim);
+  font-family: var(--mono);
+  font-size: 12px;
+}
+.mvm-bar-table tr:hover td,
+.mvm-div-table tr:hover td { background: rgba(111, 211, 255, 0.05); }
+
+/* ── conversion ── */
+.mvm-fx-converted { color: var(--gold); font-size: 18px; font-weight: 600; }
+.mvm-fx-unit {
+  font-family: var(--mono);
+  font-size: 11px;
+  color: var(--text-faint);
+  letter-spacing: 0.1em;
+}
+
+/* ── footer ── */
+.mvm-footer {
+  margin-top: 4px;
+  border-top: 1px solid var(--line);
+  padding-top: 10px;
+  font-family: var(--mono);
+  font-size: 9.5px;
+  letter-spacing: 0.12em;
+  color: var(--text-faint);
+  line-height: 1.8;
+}
+
+@media (max-width: 720px) {
+  .mvm-masthead { flex-direction: column; align-items: flex-start; }
+  .mvm-edition { flex-direction: row; gap: 10px; }
+}
