+/*
+ * Read-only Massive daily adapter for Characters beats (2026-10, replaces the
+ * retired Alpha Vantage monthly adapter).
+ *
+ * One explicit `1d` request per instrument across the five reviewed Discs:
+ * stocks (bare symbols), forex (C: pairs), crypto (X: pairs, volume-ranked),
+ * commodities (CME-group futures session bars via /futures/v1/aggs), and
+ * indices (I: tickers). Stocks/crypto/forex/indices use the shared
+ * /v2/aggs/ticker/{ticker}/range/1/day/{from}/{to} endpoint; futures use the
+ * futures endpoint with resolution=1session. Missing fields stay missing; the
+ * forming (current UTC day) bar is flagged confirmed:false rather than hidden.
+ *
+ * MASSIVE_API_KEY remains a Worker secret and is sent only in the
+ * Authorization header — never in the query string.
+ */
+import { isTickerbotSymbol } from "./good-intelligence-tickerbot.mjs";
+import "../js/characters-disc-catalog.js";
+
+export const MASSIVE_DAILY_ORIGIN = "https://api.massive.com";
+export const MASSIVE_DAILY_MAX_BARS = 60;
+const DECIMAL = /^[+-]?(?:[0-9]+(?:[.][0-9]*)?|[.][0-9]+)(?:[eE][+-]?[0-9]+)?$/;
+
+function parseProviderNumber(value) {
+  if (typeof value === "number") return Number.isFinite(value) ? value : null;
+  if (typeof value !== "string") return null;
+  const text = value.trim();
+  if (!DECIMAL.test(text)) return null;
+  const parsed = Number(text);
+  return Number.isFinite(parsed) ? parsed : null;
+}
+
+function normalizeInstrument(value) {
+  if (typeof value === "string") return normalizeInstrument({ symbol: value });
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const record = value;
+  const symbol = typeof record.symbol === "string" ? record.symbol.trim().toUpperCase() : "";
+  if (!symbol) return null;
+  const catalog = globalThis.CharactersDiscCatalog;
+
+  if (record.assetClass === "equity" && isTickerbotSymbol(symbol)) {
+    return {
+      symbol,
+      displaySymbol: symbol,
+      assetClass: "equity",
+      dataShape: "ohlcv",
+      quoteCurrency: "USD",
+      massiveTicker: symbol,
+      family: "aggs",
+      sourceLabel: "stocks daily"
+    };
+  }
+
+  if (record.assetClass === "fx" && catalog) {
+    const entry = catalog.fxCurrencies.find(item => item.symbol === symbol);
+    if (!entry || !entry.massive || !/^C:[A-Z]{6}$/.test(entry.massive.ticker || "")) return null;
+    return {
+      symbol,
+      displaySymbol: entry.displaySymbol,
+      assetClass: "fx",
+      dataShape: "ohlcv",
+      quoteCurrency: "USD",
+      massiveTicker: entry.massive.ticker,
+      family: "aggs",
+      sourceLabel: "forex daily"
+    };
+  }
+
+  if (record.assetClass === "crypto" && record.rankingProvider === "CoinGecko" && /^[A-Z0-9]{2,12}$/.test(symbol)) {
+    return {
+      symbol,
+      displaySymbol: typeof record.displaySymbol === "string" ? record.displaySymbol.slice(0, 32) : `${symbol}/USD`,
+      assetClass: "crypto",
+      dataShape: "ohlcv",
+      quoteCurrency: "USD",
+      massiveTicker: `X:${symbol}USD`,
+      family: "aggs",
+      sourceLabel: "crypto daily"
+    };
+  }
+
+  if (record.assetClass === "commodity" && catalog) {
+    const entry = catalog.commodities.find(item => item.symbol === symbol);
+    if (!entry || !entry.massive || entry.massive.family !== "futures" ||
+        !/^[A-Z0-9]{1,6}[FGHJKMNQUVXZ]\d$/.test(entry.massive.ticker || "")) return null;
+    return {
+      symbol,
+      displaySymbol: entry.displaySymbol,
+      assetClass: "commodity",
+      dataShape: "ohlcv",
+      quoteCurrency: entry.quoteCurrency,
+      massiveTicker: entry.massive.ticker,
+      family: "futures",
+      sourceLabel: "futures session"
+    };
+  }
+
+  if (record.assetClass === "index" && catalog) {
+    const entry = catalog.indices.find(item => item.symbol === symbol);
+    if (!entry || !entry.massive || !/^I:[A-Z0-9.]{1,12}$/.test(entry.massive.ticker || "")) return null;
+    return {
+      symbol,
+      displaySymbol: entry.displaySymbol,
+      assetClass: "index",
+      dataShape: "value",
+      quoteCurrency: entry.quoteCurrency,
+      massiveTicker: entry.massive.ticker,
+      family: "aggs",
+      sourceLabel: "indices daily"
+    };
+  }
+  return null;
+}
+
+function isoDaysAgo(at, days) {
+  return new Date(Number(at) - days * 86_400_000).toISOString().slice(0, 10);
+}
+
+function makeRequestUrl(instrument, at) {
+  const from = isoDaysAgo(at, 45);
+  if (instrument.family === "futures") {
+    const url = new URL(`/futures/v1/aggs/${encodeURIComponent(instrument.massiveTicker)}`, MASSIVE_DAILY_ORIGIN);
+    url.searchParams.set("resolution", "1session");
+    url.searchParams.set("window_start.gte", from);
+    url.searchParams.set("limit", String(MASSIVE_DAILY_MAX_BARS));
+    url.searchParams.set("sort", "window_start.asc");
+    return url;
+  }
+  const to = isoDaysAgo(at, 0);
+  const url = new URL(`/v2/aggs/ticker/${encodeURIComponent(instrument.massiveTicker)}/range/1/day/${from}/${to}`, MASSIVE_DAILY_ORIGIN);
+  url.searchParams.set("adjusted", "true");
+  url.searchParams.set("sort", "asc");
+  url.searchParams.set("limit", String(MASSIVE_DAILY_MAX_BARS));
+  return url;
+}
+
+function barFromAggs(row, currentDayStart) {
+  if (!row || typeof row !== "object" || Array.isArray(row)) return null;
+  const time = Number(row.t);
+  const open = parseProviderNumber(row.o);
+  const high = parseProviderNumber(row.h);
+  const low = parseProviderNumber(row.l);
+  const close = parseProviderNumber(row.c);
+  if (!Number.isFinite(time) || ![open, high, low, close].every(Number.isFinite) ||
+      Math.min(open, high, low, close) <= 0 || high < Math.max(open, close) ||
+      low > Math.min(open, close) || high < low) return null;
+  const bar = { time, open, high, low, close, confirmed: time < currentDayStart };
+  const volume = parseProviderNumber(row.v);
+  if (Number.isFinite(volume) && volume >= 0) bar.volume = volume;
+  return bar;
+}
+
+function barFromFutures(row, currentDayStart) {
+  if (!row || typeof row !== "object" || Array.isArray(row)) return null;
+  const windowStartNs = Number(row.window_start);
+  if (!Number.isFinite(windowStartNs)) return null;
+  const time = Math.round(windowStartNs / 1e6);
+  const open = parseProviderNumber(row.open);
+  const high = parseProviderNumber(row.high);
+  const low = parseProviderNumber(row.low);
+  const close = parseProviderNumber(row.close);
+  if (![open, high, low, close].every(Number.isFinite) ||
+      Math.min(open, high, low, close) <= 0 || high < Math.max(open, close) ||
+      low > Math.min(open, close) || high < low) return null;
+  const bar = { time, open, high, low, close, confirmed: time < currentDayStart };
+  const volume = parseProviderNumber(row.volume);
+  if (Number.isFinite(volume) && volume >= 0) bar.volume = volume;
+  if (typeof row.session_end_date === "string") bar.sessionEndDate = row.session_end_date;
+  return bar;
+}
+
+function failure(code, message, extra = {}) {
+  return { ok: false, code, message, ...extra };
+}
+
+function safeName(value) {
+  return typeof value === "string" && /^[A-Za-z][A-Za-z0-9]{0,31}$/.test(value) ? value : "";
+}
+
+function safeCode(value) {
+  return typeof value === "string" && /^[A-Za-z0-9_:-]{1,40}$/.test(value) ? value : "";
+}
+
+function logUpstreamFetchFailure(error, dependencies) {
+  try {
+    const cause = error && typeof error.cause === "object" ? error.cause : null;
+    const entry = {
+      event: "massive_daily_upstream_fetch_failed",
+      errorName: safeName(error && error.name) || "Error",
+      causeName: safeName(cause && cause.name),
+      causeCode: safeCode(cause && cause.code)
+    };
+    if (typeof dependencies.log === "function") dependencies.log(entry);
+    else console.warn("[HarshalOS Massive]", entry);
+  } catch { /* Logging must never affect request handling. */ }
+}
+
+function providerMessage(payload) {
+  const error = typeof payload?.error === "string" ? payload.error
+    : typeof payload?.message === "string" ? payload.message : "";
+  const text = error.toLowerCase();
+  if (/rate|limit|too many|throttl/.test(text)) {
+    return failure("massive-rate-limit", "Massive's per-minute request envelope was reached. Daily bars are not substituted from another provider.");
+  }
+  if (error) return failure("massive-upstream", `Massive could not provide this daily series right now. Massive said: ${error.slice(0, 200)}`);
+  return failure("massive-unreadable", "Massive returned no recognizable daily market series.");
+}
+
+/*
+ * One request for an explicit Massive daily series. The caller claims the
+ * durable per-UTC-day allowance (and the shared per-minute envelope) before
+ * invoking this helper.
+ *
+ *   { ok: true, packet }                      — gi-market-context-v1, timeframe=1d
+ *   { ok: false, code, message, retryAfter? } — safe failure, never throws
+ */
+export async function fetchMassiveDailyMarketContext({
+  instrument: rawInstrument,
+  symbol,
+  apiKey,
+  fetcher = globalThis.fetch,
+  now = Date.now(),
+  timeoutMs = 10_000,
+  dependencies = {}
+} = {}) {
+  const original = rawInstrument && typeof rawInstrument === "object"
+    ? rawInstrument
+    : { symbol, assetClass: "equity" };
+  const instrument = normalizeInstrument(original);
+  if (!instrument) {
+    return failure("massive-instrument-refused", "This instrument is not on a reviewed Characters Disc or live volume-ranked crypto list.");
+  }
+  if (original.interval !== undefined && original.interval !== "1d") {
+    return failure("massive-interval-refused", "Massive beats are restricted to an explicit 1d request; Tickerbot serves 1h on demand.");
+  }
+  if (typeof apiKey !== "string" || !apiKey.trim()) {
+    return failure("massive-not-configured", "Add the MASSIVE_API_KEY Worker secret to enable Massive daily beats.");
+  }
+  if (typeof fetcher !== "function") {
+    return failure("massive-unavailable", "Massive is unavailable in this Worker runtime.");
+  }
+
+  const url = makeRequestUrl(instrument, now);
+  const timeout = Number.isFinite(Number(timeoutMs)) ? Math.max(1, Number(timeoutMs)) : 10_000;
+  const controller = typeof AbortController === "function" ? new AbortController() : null;
+  const timer = controller ? setTimeout(() => controller.abort(), timeout) : null;
+
+  try {
+    const response = await fetcher(url.toString(), {
+      method: "GET",
+      headers: { Accept: "application/json", Authorization: `Bearer ${apiKey.trim()}` },
+      redirect: "manual",
+      ...(controller ? { signal: controller.signal } : {})
+    });
+    if (!response || !response.ok) {
+      const status = Number(response && response.status) || 0;
+      if (status === 429) {
+        const retryAfter = response.headers && response.headers.get ? response.headers.get("retry-after") : "";
+        return failure("massive-rate-limit", "Massive's per-minute request envelope was reached. Wait before beating again.", {
+          retryAfter: /^\d{1,5}$/.test(retryAfter || "") ? retryAfter : "60"
+        });
+      }
+      if (status === 401 || status === 403) {
+        return failure("massive-unauthorized", "Massive rejected the Worker key. Check the MASSIVE_API_KEY Worker secret.");
+      }
+      let payload = null;
+      try { payload = await response.json(); } catch { /* unreadable refusal body */ }
+      return providerMessage(payload);
+    }
+
+    let payload;
+    try { payload = await response.json(); }
+    catch { return failure("massive-unreadable", "Massive returned unreadable daily data."); }
+    const rows = Array.isArray(payload && payload.results) ? payload.results : [];
+    const currentDayStart = Date.parse(`${new Date(Number(now)).toISOString().slice(0, 10)}T00:00:00.000Z`);
+    const shaper = instrument.family === "futures" ? barFromFutures : barFromAggs;
+    const unique = new Map();
+    for (const row of rows) {
+      const bar = shaper(row, currentDayStart);
+      if (bar) unique.set(bar.time, bar);
+    }
+    const bars = Array.from(unique.values()).sort((a, b) => a.time - b.time).slice(-MASSIVE_DAILY_MAX_BARS);
+    if (!bars.length) {
+      return failure("massive-empty", `Massive returned no daily bars for ${instrument.massiveTicker} in the trailing window.`);
+    }
+
+    return {
+      ok: true,
+      packet: {
+        schema: "gi-market-context-v1",
+        synthetic: false,
+        source: `Massive · ${instrument.sourceLabel} bars · request ${typeof payload.request_id === "string" ? payload.request_id.slice(0, 24) : "n/a"}`,
+        symbol: instrument.symbol,
+        massiveTicker: instrument.massiveTicker,
+        timeframe: "1d",
+        bars
+      }
+    };
+  } catch (error) {
+    logUpstreamFetchFailure(error, dependencies);
+    if (error && error.name === "AbortError") {
+      return failure("massive-timeout", "Massive daily request timed out. Try again shortly.");
+    }
+    return failure("massive-unreachable", "Massive could not be reached from this Worker.");
+  } finally {
+    if (timer !== null) clearTimeout(timer);
+  }
+}
+
+export const massiveDailyInternals = Object.freeze({
+  normalizeInstrument,
+  makeRequestUrl,
+  barFromAggs,
+  barFromFutures,
+  MASSIVE_DAILY_MAX_BARS
+});
