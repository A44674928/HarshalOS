+            ${recent.map(bar => `<tr>
+              <td>${esc(timeLabel(bar.t))}</td>
+              <td>${esc(String(bar.o ?? "—"))}</td><td>${esc(String(bar.h ?? "—"))}</td>
+              <td>${esc(String(bar.l ?? "—"))}</td><td>${esc(String(bar.c ?? "—"))}</td>
