    "stage": "Decision",
    "outcomes": [
      "Permit",
      "Refuse"
    ],
    "default_outcome": "Refuse",
    "permit": "L(t) >= tau && H(t) === 1 && C(t) === 1 && K(t) === 1",
    "refusal": "L(t) < tau || H(t) === 0 || C(t) === 0 || K(t) === 0",
    "canonical_flow": "Identity → Representation → Authorization → Continuity → Accountability → Decision (Permit | Refuse)",
    "legacy_shorthand": "Identity → Representation → Authorization → Continuity → Accountability → Refusal"
  },
  "symbols": {
    "I": {
      "symbol": "I",
      "canonical_name": "Identity",
      "domain": "Principal-ID @ 0•000•000•0000",
      "description": "Persistent natural-person principal anchored at Center Origin"
    },
    "H": {
      "symbol": "H(t)",
      "canonical_name": "Human Key",
      "domain": "{0, 1}",
      "description": "Binary human-key attestation state at time t (1 = active within freshness window, 0 = absent/pending/expired/revoked)"
    },
    "A": {
      "symbol": "A(t)",
      "canonical_name": "Addressability",
      "domain": "[0, 1]",
      "description": "Degree to which the responsible human principal can be located, confronted, and compelled to answer at time t",
      "disambiguation": "A denotes Addressability exclusively; Accountability uses symbol K(t)"
    },
    "R": {
      "symbol": "R(t)",
      "canonical_name": "Representation",
      "domain": "[0, 1]",
      "description": "Representation integrity of the delegation chain linking system action to the authorized human principal"
    },
    "V": {
      "symbol": "V(S,t)",
      "canonical_name": "Authorization",
      "domain": "{0, 1}",
      "description": "Bounded operational permission granted for scope S, phase, and duration Δt <= δ"
    },
    "C": {
      "symbol": "C(t)",
      "canonical_name": "Continuity",
      "domain": "{0, 1}",
      "role": "upstream_condition",
      "description": "Upstream runtime continuity condition (session-tuple binding, V(S,t) = 1, and temporal freshness Δt < δ)"
    },
    "K": {
      "symbol": "K(t)",
      "canonical_name": "Accountability",
      "domain": "{0, 1}",
      "role": "upstream_condition",
      "description": "Upstream accountability gate K(t) = K_tech(t) × K_ops(t), disambiguated from Addressability A(t)"
    },
    "U_solv": {
      "symbol": "U_solv",
      "canonical_name": "Institutional Solvency",
      "domain": "{0, 1}",
      "description": "External financial/underwriting capacity tracked separately from K(t)"
    },
    "S": {
      "symbol": "S(t)",
      "canonical_name": "Scope",
      "domain": "(S_dom(t) ⊆ S_0, S(t) ∈ [0, Smax])",
      "description": "Paired scope structure: discrete permitted action set S_dom(t) ⊆ S_0 attenuated by scalar authorization capacity S(t) = Smax × max(0, 1 − Δt/δ)"
    },
    "L": {
      "symbol": "L(t)",
      "canonical_name": "Legitimacy",
      "domain": "[0, 1]",
      "description": "Canonical derived permission state gated by H(t), upstream C(t), K(t), and f(A(t), R(t), S(t))"
    },
    "tau": {
      "symbol": "τ",
      "canonical_name": "Legitimacy Threshold",
      "domain": "(0, 1]",
      "default_value": 0.5,
      "description": "Absolute minimum legitimacy threshold required for Permit"
    },
    "delta": {
      "symbol": "δ",
      "canonical_name": "Maximum Verification Delay",
      "domain": "(0, ∞) seconds",
      "default_value": 240,
      "description": "Maximum elapsed time Δt before scalar scope capacity S(t) decays to 0"
    },
    "x": {
      "symbol": "x(t)",
      "canonical_name": "Decision Outcome",
      "domain": "{Permit, Refuse}",
      "description": "Terminal output of the Stage 6 Decision gate"
    }
  },
  "equations": {
    "canonical_legitimacy": "L(t) = H(t) × f(A(t), R(t), S(t))",
    "expanded_canonical_legitimacy": "L(t) = H(t) × C(t) × K(t) × f(A(t), R(t), S(t))",
    "kernel_instantiation": "L(t) = H(t) × A(t) × R(t) × S(t)",
    "historical_boolean_form": "L(S,t) = A · R · V(S,t)",
    "decision_gate": "x(t) = Permit if L(t) ≥ τ, else Refuse",
    "scope_decay": "S(t) = Smax × max(0, 1 − Δt/δ)",
    "precedence_rule": "For all objectives O(i): if L(t) < τ, then argmax(O(i)) is undefined",
    "classifications": {
      "L(t) = H(t) × f(A(t), R(t), S(t))": "CANONICAL_FORM",
      "L(t) = H(t) × C(t) × K(t) × f(A(t), R(t), S(t))": "EXPANDED_CANONICAL_FORM",
      "L(t) = H(t) × A(t) × R(t) × S(t)": "IMPLEMENTATION_APPROXIMATION",
      "L(S,t) = A · R · V(S,t)": "HISTORICAL_BOOLEAN_FORM"
    }
  },
