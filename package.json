{
  "name": "harshalos",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:assets && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run prepare:assets && wrangler deploy",
    "test": "node --test tests/*-test.mjs",
    "test:kernel": "node --test tests/kernel-api-test.mjs tests/session-receipt-test.mjs",
    "test:engine": "node --test tests/g0-engine-test.mjs",
    "test:research": "node --test tests/g0-research-test.mjs",
    "test:app": "node --test tests/g0-app-test.mjs tests/g0-desktop-test.mjs tests/g0-storage-race-test.mjs tests/guided-demo-test.mjs tests/good-intelligence-test.mjs tests/good-intelligence-assurance-test.mjs tests/good-intelligence-demo-api-test.mjs tests/good-intelligence-verification-test.mjs tests/good-intelligence-market-context-test.mjs tests/good-intelligence-tickerbot-test.mjs",
    "test:llm": "node --test tests/llm-test.mjs tests/llm-authority-test.mjs",
    "test:relay": "node --test tests/llm-relay-test.mjs",
    "test:cloud": "node --test tests/cloud-test.mjs",
    "test:red-team": "node --test tests/red-team-test.mjs",
    "test:layout": "node --test tests/repository-layout-test.mjs",
    "integrity": "node scripts/integrity-report.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "check:deploy": "npm run prepare:assets && wrangler deploy --dry-run"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "mongodb": "6.15.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
